---
import MainLayout from '../layouts/MainLayout.astro';
import { siteData } from '../data/site';

const { seo, person, hero, about, experience, projects, skills, education, languages } = siteData;

const sortedProjects = [...projects].sort((a, b) => {
  const featuredWeight = Number(b.featured) - Number(a.featured);
  if (featuredWeight !== 0) return featuredWeight;
  return a.priority - b.priority;
});
---

<MainLayout seo={seo} person={person}>
  <a href="#contenido" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 bg-ink text-paper px-3 py-2 rounded-md">Saltar al contenido</a>

  <header class="sticky top-0 z-20 backdrop-blur bg-paper/75 border-b border-ink/10">
    <nav class="max-w-6xl mx-auto px-5 md:px-8 py-4 flex items-center justify-between">
      <p class="font-display text-lg">{person.name}</p>
      <ul class="hidden md:flex items-center gap-6 text-sm text-muted">
        <li><a class="hover:text-ink transition-colors" href="#sobre-mi">Sobre mí</a></li>
        <li><a class="hover:text-ink transition-colors" href="#proyectos">Proyectos</a></li>
        <li><a class="hover:text-ink transition-colors" href="#stack">Stack</a></li>
        <li><a class="hover:text-ink transition-colors" href="#contacto">Contacto</a></li>
      </ul>
    </nav>
  </header>

  <main id="contenido" class="max-w-6xl mx-auto px-5 md:px-8 py-10 md:py-14 space-y-8">
    <section class="section-shell p-6 md:p-10 editorial-grid reveal" id="home">
      <p class="kicker">{hero.badge}</p>
      <h1 class="font-display text-4xl md:text-6xl leading-tight max-w-3xl">{hero.headline}</h1>
      <p class="text-muted text-base md:text-lg max-w-2xl">{hero.subheadline}</p>
      <div class="flex flex-wrap gap-3 pt-2">
        <a class="inline-flex items-center justify-center min-h-11 px-5 rounded-full bg-ink text-paper font-medium hover:bg-ink/90 transition-colors" href={`mailto:${person.email}`}>Escribirme por correo</a>
        <a class="inline-flex items-center justify-center min-h-11 px-5 rounded-full border border-ink/20 text-ink font-medium hover:border-ink/40 transition-colors" href={person.cvUrl} target="_blank" rel="noreferrer">Ver CV</a>
      </div>
      <dl class="grid grid-cols-1 md:grid-cols-3 gap-4 pt-4">
        <div class="border border-ink/10 rounded-xl p-4 bg-paper/60">
          <dt class="text-xs uppercase tracking-[0.15em] text-muted">Rol</dt>
          <dd class="mt-1 font-medium">{person.role}</dd>
        </div>
        <div class="border border-ink/10 rounded-xl p-4 bg-paper/60">
          <dt class="text-xs uppercase tracking-[0.15em] text-muted">Ubicación</dt>
          <dd class="mt-1 font-medium">{person.location}</dd>
        </div>
        <div class="border border-ink/10 rounded-xl p-4 bg-paper/60">
          <dt class="text-xs uppercase tracking-[0.15em] text-muted">Idiomas</dt>
          <dd class="mt-1 font-medium">{languages.map((lang) => `${lang.name} (${lang.level})`).join(' · ')}</dd>
        </div>
      </dl>
    </section>

    <section class="section-shell p-6 md:p-10 reveal delay-1" id="sobre-mi">
      <p class="kicker">Sobre mí</p>
      <h2 class="section-title mt-2">Perfil profesional</h2>
      <div class="mt-5 space-y-4 text-muted leading-relaxed max-w-3xl">
        <p>{person.summary}</p>
        {about.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </section>

    <section class="section-shell p-6 md:p-10 reveal delay-2" id="experiencia">
      <p class="kicker">Experiencia</p>
      <h2 class="section-title mt-2">Trayectoria profesional</h2>
      <div class="mt-6 space-y-5">
        {experience.map((job) => (
          <article class="rounded-xl border border-ink/10 p-5 bg-paper/70">
            <div class="flex flex-wrap items-start justify-between gap-3">
              <div>
                <h3 class="font-semibold text-lg">{job.role} · {job.company}</h3>
                <p class="text-sm text-muted">{job.period} · {job.location}</p>
              </div>
              {job.type === 'transferable' && (
                <span class="inline-flex items-center rounded-full bg-highlight/10 text-highlight px-3 py-1 text-xs font-semibold">
                  Habilidades transferibles
                </span>
              )}
            </div>
            <ul class="mt-4 space-y-2 text-sm md:text-base text-muted list-disc pl-5">
              {job.highlights.map((item) => <li>{item}</li>)}
            </ul>
          </article>
        ))}
      </div>
    </section>

    <section class="section-shell p-6 md:p-10 reveal" id="proyectos">
      <p class="kicker">Proyectos</p>
      <h2 class="section-title mt-2">Trabajo destacado</h2>
      <p class="text-muted mt-3 max-w-3xl">Seleccioné tres proyectos con impacto real y stack Full-Stack. Equilibria se mantiene como proyecto principal por alcance técnico.</p>
      <div class="mt-6 grid gap-4 md:gap-5 md:grid-cols-2 xl:grid-cols-3">
        {sortedProjects.map((project, index) => (
          <article class={`rounded-xl border border-ink/10 p-5 bg-paper/70 flex flex-col ${index === 0 ? 'xl:col-span-3 md:grid md:grid-cols-2 md:gap-5' : ''}`}>
            <div>
              <p class="text-xs uppercase tracking-[0.15em] text-muted">{project.subtitle}</p>
              <h3 class="font-display text-2xl mt-1">{project.name}</h3>
              <p class="mt-3 text-sm text-muted"><strong class="text-ink font-semibold">Problema:</strong> {project.problem}</p>
              <p class="mt-2 text-sm text-muted"><strong class="text-ink font-semibold">Solución:</strong> {project.solution}</p>
              <p class="mt-2 text-sm text-muted"><strong class="text-ink font-semibold">Impacto:</strong> {project.impact}</p>
            </div>
            <div class={`mt-4 ${index === 0 ? 'md:mt-0' : ''}`}>
              <ul class="flex flex-wrap gap-2">
                {project.stack.map((tech) => (
                  <li class="text-xs font-medium px-2.5 py-1.5 rounded-full bg-accent/10 text-accent border border-accent/15">{tech}</li>
                ))}
              </ul>
              <div class="mt-4 flex flex-wrap gap-3">
                <a class="inline-flex items-center justify-center min-h-11 px-4 rounded-full border border-ink/20 text-ink text-sm font-medium hover:border-ink/40 transition-colors" href={project.repoUrl} target="_blank" rel="noreferrer">GitHub</a>
                {project.demoUrl && (
                  <a class="inline-flex items-center justify-center min-h-11 px-4 rounded-full bg-accent text-white text-sm font-medium hover:bg-accent/90 transition-colors" href={project.demoUrl} target="_blank" rel="noreferrer">Ver demo</a>
                )}
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="section-shell p-6 md:p-10 reveal delay-1" id="stack">
      <p class="kicker">Stack</p>
      <h2 class="section-title mt-2">Tecnologías y prácticas</h2>
      <div class="mt-6 grid gap-4 md:grid-cols-3">
        {skills.map((group) => (
          <article class="rounded-xl border border-ink/10 p-5 bg-paper/70">
            <h3 class="font-semibold text-lg">{group.title}</h3>
            <ul class="mt-3 flex flex-wrap gap-2">
              {group.items.map((item) => (
                <li class="text-xs font-medium px-2.5 py-1.5 rounded-full border border-ink/15 bg-white/70">{item}</li>
              ))}
            </ul>
          </article>
        ))}
      </div>
    </section>

    <section class="section-shell p-6 md:p-10 reveal delay-2" id="educacion">
      <p class="kicker">Educación</p>
      <h2 class="section-title mt-2">Formación</h2>
      <div class="mt-6 grid gap-4 md:grid-cols-2">
        {education.map((item) => (
          <article class="rounded-xl border border-ink/10 p-5 bg-paper/70">
            <h3 class="font-semibold text-lg">{item.title}</h3>
            <p class="text-muted mt-1">{item.institution}</p>
            <p class="text-sm text-muted mt-1">{item.period}</p>
            {item.link && (
              <a class="inline-flex items-center text-sm font-medium mt-3 text-accent hover:underline" href={item.link} target="_blank" rel="noreferrer">Ver certificado</a>
            )}
          </article>
        ))}
      </div>
    </section>

    <section class="section-shell p-6 md:p-10 reveal" id="contacto">
      <p class="kicker">Contacto</p>
      <h2 class="section-title mt-2">Conectemos</h2>
      <p class="text-muted mt-3 max-w-2xl">Busco oportunidades donde pueda aportar como Full-Stack Developer en equipos orientados a producto y mejora continua.</p>
      <div class="mt-5 flex flex-wrap gap-3">
        <a class="inline-flex items-center justify-center min-h-11 px-5 rounded-full bg-ink text-paper font-medium hover:bg-ink/90 transition-colors" href={`mailto:${person.email}`}>Email</a>
        <a class="inline-flex items-center justify-center min-h-11 px-5 rounded-full border border-ink/20 text-ink font-medium hover:border-ink/40 transition-colors" href={person.linkedin} target="_blank" rel="noreferrer">LinkedIn</a>
        <a class="inline-flex items-center justify-center min-h-11 px-5 rounded-full border border-ink/20 text-ink font-medium hover:border-ink/40 transition-colors" href={person.github} target="_blank" rel="noreferrer">GitHub</a>
      </div>
      <p class="text-sm text-muted mt-4">Contacto principal: <a class="underline decoration-ink/30 underline-offset-4" href={`mailto:${person.email}`}>{person.email}</a></p>
    </section>
  </main>
</MainLayout>
